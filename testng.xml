<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Playwright Framework Suite" parallel="methods" thread-count="1">
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="com.playwright.framework.listeners.TestListener"/>
    </listeners>
    <test name="DemoQA Tests">
        <packages>
            <package name="com.playwright.framework.tests"/>
        </packages>
    </test>
</suite>
