<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Playwright Framework Suite" parallel="tests" thread-count="3">
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="com.playwright.framework.listeners.TestListener"/>
    </listeners>
    <test name="Text Box Tests">
        <classes>
            <class name="com.playwright.framework.tests.AddTextVerificationTest"/>
        </classes>
    </test>
    <test name="Check Box Tests">
        <classes>
            <class name="com.playwright.framework.tests.CheckBoxesTest"/>
        </classes>
    </test>
    <test name="Practice Form Tests">
        <classes>
            <class name="com.playwright.framework.tests.PracticeFormTest"/>
        </classes>
    </test>
</suite>
